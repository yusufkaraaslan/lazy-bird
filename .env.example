# Lazy-Bird v2.0 Environment Configuration
# Copy this file to .env and update with your actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://lazy_bird:your_password_here@localhost:5432/lazy_bird

# Database connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# CELERY CONFIGURATION
# =============================================================================

# Celery broker (use Redis)
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery result backend
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# =============================================================================
# API CONFIGURATION
# =============================================================================

# API server settings
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE="Lazy-Bird API"
API_VERSION="2.0.0"

# CORS allowed origins (comma-separated)
# For development, allow localhost origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# API rate limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# =============================================================================
# SECURITY
# =============================================================================

# Secret key for JWT token signing (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-change-in-production-use-openssl-rand-hex-32

# API key salt for hashing (generate with: openssl rand -hex 16)
API_KEY_SALT=your-api-key-salt-here-change-in-production

# JWT settings
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# =============================================================================
# CLAUDE API
# =============================================================================

# Default Claude model
CLAUDE_DEFAULT_MODEL=claude-sonnet-4-5

# Claude API timeout (seconds)
CLAUDE_TIMEOUT_SECONDS=300

# =============================================================================
# TASK EXECUTION
# =============================================================================

# Default task timeout (seconds)
DEFAULT_TASK_TIMEOUT=1800

# Maximum concurrent tasks per project
MAX_CONCURRENT_TASKS_PER_PROJECT=3

# Task retry settings
MAX_TASK_RETRIES=3
TASK_RETRY_DELAY_SECONDS=60

# =============================================================================
# COST TRACKING
# =============================================================================

# Default cost limits (USD)
DEFAULT_MAX_COST_PER_TASK=5.00
DEFAULT_DAILY_COST_LIMIT=50.00
DEFAULT_MONTHLY_BUDGET=1000.00

# =============================================================================
# GIT CONFIGURATION
# =============================================================================

# Git worktree base directory
GIT_WORKTREE_BASE=/tmp/lazy-bird-worktrees

# Default git branch
DEFAULT_GIT_BRANCH=main

# =============================================================================
# LOGGING
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log format
LOG_FORMAT=json

# Log file path (leave empty for stdout only)
LOG_FILE_PATH=

# Log retention days
LOG_RETENTION_DAYS=30

# =============================================================================
# WEBHOOKS
# =============================================================================

# Webhook retry settings
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY_SECONDS=60
WEBHOOK_TIMEOUT_SECONDS=10

# Disable webhook after N consecutive failures
WEBHOOK_DISABLE_AFTER_FAILURES=10

# =============================================================================
# MONITORING
# =============================================================================

# Enable Prometheus metrics endpoint
ENABLE_METRICS=true

# Metrics port
METRICS_PORT=9090

# Health check interval (seconds)
HEALTH_CHECK_INTERVAL=60

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Enable debug mode (NEVER use in production)
DEBUG=true

# Enable API documentation
ENABLE_DOCS=true

# API docs URL paths
DOCS_URL=/docs
REDOC_URL=/redoc

# =============================================================================
# OPTIONAL: LEGACY v1.1 SUPPORT
# =============================================================================

# Flask settings (for gradual migration)
FLASK_PORT=5000
FLASK_DEBUG=false

# =============================================================================
# OPTIONAL: EXTERNAL SERVICES
# =============================================================================

# GitHub API token (for PR creation)
# GITHUB_TOKEN=ghp_your_token_here

# GitLab API token
# GITLAB_TOKEN=glpat_your_token_here

# Sentry DSN (for error tracking)
# SENTRY_DSN=https://your-sentry-dsn-here

# =============================================================================
# NOTES
# =============================================================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Update all values marked with "your_*_here"
# 3. Generate secure secrets using: openssl rand -hex 32
# 4. NEVER commit .env to version control
# 5. See docs/refactor/01-architecture.md for detailed configuration guide
